# 模型服务：使用 Codex 本机账户方式时可以不填 OPENAI_API_KEY
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 运行次数
AGENT_MAX_RETRIES=10
STRATEGYAGENT_MAX_RETRIES=10
MAX_EPOCHS=10
MAX_STRATEGY_VALIDATE_ROUNDS=6

# 资料读取方式：基础资料可用 sqlite 或 dolphindb；回测可用 sqlite、dolphindb、parquet 或 event_parquet
QUANTA_DATA_ENGINE=sqlite
QUANTA_BACKTEST_DB_BACKEND=sqlite

# SQLite 文件
SQLITE_MARKET_DATA_DB_PATH=./market_data.db
SQLITE_BACKTEST_DB_PATH=./vnpy_bar.sqlite3

# DolphinDB：不使用时可以保持示例值
DOLPHINDB_HOST=localhost
DOLPHINDB_PORT=8848
DOLPHINDB_USER=replace_with_your_user
DOLPHINDB_PASSWORD=replace_with_your_password
DOLPHINDB_TIMEZONE=Asia/Shanghai
DOLPHINDB_MARKET_DATA_DB=dfs://market_data
DOLPHINDB_BACKTEST_DB=dfs://vnpy_bar_db

# 本地日线 Parquet：按实际位置修改
QUANTA_PARQUET_DATA_GLOB=D:/your_data/daily_by_stock/*.parquet
QUANTA_CSI300_MEMBERSHIP_FILE=D:/your_data/csi300.txt

# 分钟事件资料：只在 event_parquet 方式下填写
QUANTA_EVENT_FEATURES_PATH=D:/your_data/minute_events.parquet

# 网页和日志
QUANTA_AGENTS_WEBAPP_PORT=8000
QUANTA_HISTORY_TAIL=20
QUANTA_ENABLE_FAULTHANDLER=true
